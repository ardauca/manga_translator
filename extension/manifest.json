{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "0.5.0",
  "description": "Ücretsiz, lokal manga çevirisi - Japoncayı / İngilizceyı Türkçeye çevir",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Manga Translator"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/style.css"]
    }
  ]
}
